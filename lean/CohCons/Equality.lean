import CohCons.Transfer

/-!
# Lemma 3.3: removing equality

`Γ.withEq` is `Γ^=`, the expansion of `Γ` by a binary symbol `eq` (the symbol `none`) interpreted
as equality. For a `Γ^=`-instance `J`, `≈` is the equivalence relation generated by `eq^J` and
`quot J` is `J/≈`.
-/

open Finset Classical

noncomputable section

set_option linter.unusedSectionVars false

namespace CohCons

variable {L : Sig} {G β : Type}

/-- The signature `σ ∪ {eq}`; the symbol `none` is the binary symbol `eq`. -/
def Sig.withEq (L : Sig) : Sig where
  Sym := Option L.Sym
  ar s := match s with
    | none => 2
    | some R => L.ar R

instance [Fintype L.Sym] : Fintype L.withEq.Sym := inferInstanceAs (Fintype (Option L.Sym))

/-- `Γ^=`. The relation `eq` consists of the tuples whose entries are all equal. -/
def Str.withEq (Γ : Str L G) : Str L.withEq G where
  rel s := match s with
    | none => {t | ∀ i j, t i = t j}
    | some R => Γ.rel R

/-- `eq` is interpreted as equality. -/
lemma withEq_rel_none_iff (Γ : Str L G) (t : Fin 2 → G) :
    t ∈ Γ.withEq.rel none ↔ t 0 = t 1 := by
  change (∀ i j, t i = t j) ↔ _
  constructor
  · intro h; exact h 0 1
  · intro h i j
    fin_cases i <;> fin_cases j <;> simp [h]

/-- `u` and `w` are entries of a common `eq`-tuple of `J`. -/
def EqEdge (J : Str L.withEq β) (u w : β) : Prop :=
  ∃ t ∈ J.rel none, ∃ i j, t i = u ∧ t j = w

lemma EqEdge.symm {J : Str L.withEq β} {u w : β} (h : EqEdge J u w) : EqEdge J w u := by
  obtain ⟨t, ht, i, j, hi, hj⟩ := h
  exact ⟨t, ht, j, i, hj, hi⟩

/-- `≈`: the equivalence relation generated by `eq^J`. -/
def eqSetoid (J : Str L.withEq β) : Setoid β where
  r := Relation.ReflTransGen (EqEdge J)
  iseqv := ⟨fun _ => Relation.ReflTransGen.refl,
    fun h => by
      induction h with
      | refl => exact Relation.ReflTransGen.refl
      | tail _ hbc ih => exact Relation.ReflTransGen.head (EqEdge.symm hbc) ih,
    Relation.ReflTransGen.trans⟩

/-- `J/≈`. -/
def quot (J : Str L.withEq β) : Str L (Quotient (eqSetoid J)) where
  rel R := {c | ∃ u ∈ J.rel (some R), (fun i => Quotient.mk (eqSetoid J) (u i)) = c}

/-- `J/≈ → Γ` implies `J → Γ^=`. -/
lemma hom_of_quot_hom {Γ : Str L G} {J : Str L.withEq β} {h : Quotient (eqSetoid J) → G}
    (hh : IsHom (quot J) Γ h) : IsHom J Γ.withEq (h ∘ Quotient.mk (eqSetoid J)) := by
  intro s t ht
  cases s with
  | none =>
    change ∀ i j, h (Quotient.mk _ (t i)) = h (Quotient.mk _ (t j))
    intro i j
    rw [Quotient.sound (Relation.ReflTransGen.single (⟨t, ht, i, j, rfl, rfl⟩ : EqEdge J _ _))]
  | some R =>
    exact hh R _ ⟨t, ht, rfl⟩

lemma fin_two_cover (i j l : Fin 2) (h : i ≠ j) : l = i ∨ l = j := by
  fin_cases i <;> fin_cases j <;> fin_cases l <;> simp_all

variable [Fintype β]

/-- **Lemma 3.3.** If `Γ` has arities at most `ρ` and `C_{k+ρ+1}(Γ^=)` accepts `J`, then
`C_k(Γ)` accepts `J/≈`. -/
theorem accepts_quot {pin : Bool} {Γ : Str L G} {ρ : ℕ} (hρ : ∀ R, L.ar R ≤ ρ)
    {J : Str L.withEq β} {k : ℕ} (hacc : Accepts pin (k + ρ + 1) J Γ.withEq) :
    Accepts pin k (quot J) Γ := by
  obtain ⟨S, hS, hemp⟩ := hacc
  -- The claim: on sets of size at most `k + ρ`, members of `S` are constant on `≈`-classes.
  have claim : ∀ u w : β, (eqSetoid J).r u w → ∀ f ∈ S, (dom f).card ≤ k + ρ →
      u ∈ dom f → w ∈ dom f → f u = f w := by
    intro u w huw
    change Relation.ReflTransGen (EqEdge J) u w at huw
    induction huw using Relation.ReflTransGen.head_induction_on with
    | refl => intros; rfl
    | @head a c hac _ ih =>
      intro f hf hcard ha hw
      by_cases haw : a = w
      · rw [haw]
      obtain ⟨f', hf', hf'd, hf'r⟩ := hS.forth f hf (insert c (dom f)) (subset_insert _ _)
        ((card_insert_le _ _).trans (by omega))
      have e1 : f' a = f a := apply_eq_of_res_eq hf'r ha
      have e2 : f' w = f w := apply_eq_of_res_eq hf'r hw
      have e3 : f' a = f' c := by
        obtain ⟨t, ht, i, j, hi, hj⟩ := hac
        by_cases hij : i = j
        · rw [← hi, ← hj, hij]
        have hcov : ∀ l, t l = a ∨ t l = c := fun l => by
          rcases fin_two_cover i j l hij with rfl | rfl
          · exact Or.inl hi
          · exact Or.inr hj
        obtain ⟨v, hv, hfv⟩ := (hS.phom f' hf').exists_tuple ht (fun l => by
          rw [hf'd]
          rcases hcov l with h | h <;> rw [h]
          · exact mem_insert_of_mem ha
          · exact mem_insert_self _ _)
        have hv' : ∀ i j, v i = v j := hv
        rw [← hi, ← hj, hfv i, hfv j, hv' i j]
      let Y := insert c ((dom f).erase a)
      have hY : Y ⊆ dom f' := by
        rw [hf'd]
        exact insert_subset_insert _ (erase_subset _ _)
      have hYd : dom (res f' Y) = Y := dom_res_of_subset hY
      have hcY : c ∈ Y := mem_insert_self _ _
      have hwY : w ∈ Y := mem_insert_of_mem (mem_erase.2 ⟨Ne.symm haw, hw⟩)
      have hcardY : Y.card ≤ k + ρ := by
        have h1 : Y.card ≤ ((dom f).erase a).card + 1 := card_insert_le _ _
        have h2 := card_erase_of_mem ha
        have h3 : 0 < (dom f).card := card_pos.2 ⟨a, ha⟩
        omega
      have := ih (res f' Y) (hS.down f' hf' Y hY) (by rw [hYd]; exact hcardY)
        (by rw [hYd]; exact hcY) (by rw [hYd]; exact hwY)
      rw [res_apply_of_mem hcY, res_apply_of_mem hwY] at this
      rw [← e1, e3, this, e2]
  -- Transfer along a choice of representatives.
  let rep : Quotient (eqSetoid J) → β := Quotient.out
  have hrep : ∀ c, Quotient.mk (eqSetoid J) (rep c) = c := Quotient.out_eq
  refine transfer hS hemp (fun X => X.image rep) (fun X f c => if c ∈ X then f (rep c) else none)
    (fun X Y h => image_subset_image h) (fun X hX => card_image_le.trans (by omega)) ?_ ?_ ?_
  · intro X _ f _ hfd
    ext c
    rw [mem_dom]
    by_cases hc : c ∈ X
    · simp only [hc, ↓reduceIte, ne_eq, iff_true]
      have : rep c ∈ dom f := by rw [hfd]; exact mem_image_of_mem _ hc
      exact mem_dom.1 this
    · simp [hc]
  · intro X Y _ hYX f _ _
    funext c
    by_cases hc : c ∈ Y
    · have hcX : c ∈ X := hYX hc
      simp [res, hc, hcX, mem_image_of_mem rep hc]
    · simp [res, hc]
  · intro X hX f hf hfd R c b hc hb
    obtain ⟨u, hu, rfl⟩ := hc
    have hb' : ∀ i, Quotient.mk _ (u i) ∈ X ∧ f (rep (Quotient.mk _ (u i))) = some (b i) := by
      intro i
      have := hb i
      by_cases h : Quotient.mk (eqSetoid J) (u i) ∈ X
      · simp only [h, ↓reduceIte] at this
        exact ⟨h, this⟩
      · simp [h] at this
    have har : (univ : Finset (Fin (L.withEq.ar (some R)))).card ≤ ρ := by
      rw [card_univ, Fintype.card_fin]
      exact hρ R
    let Z := X.image rep ∪ univ.image u
    have hZ : Z.card ≤ k + ρ :=
      (card_union_le _ _).trans (add_le_add (card_image_le.trans hX) (card_image_le.trans har))
    obtain ⟨f', hf', hf'd, hf'r⟩ :=
      hS.forth f hf Z (by rw [hfd]; exact subset_union_left) (by omega)
    obtain ⟨v, hv, hfv⟩ := (hS.phom f' hf').exists_tuple hu
      (fun i => by rw [hf'd]; exact mem_union_right _ (mem_image_of_mem _ (mem_univ i)))
    have hvb : v = b := by
      funext i
      have hrepi : rep (Quotient.mk _ (u i)) ∈ dom f := by
        rw [hfd]; exact mem_image_of_mem _ (hb' i).1
      have h1 : f' (u i) = f' (rep (Quotient.mk _ (u i))) :=
        claim (u i) _ (Quotient.exact (hrep _).symm) f' hf' (by rw [hf'd]; exact hZ)
          (by rw [hf'd]; exact mem_union_right _ (mem_image_of_mem _ (mem_univ i)))
          (by rw [hf'd]; exact mem_union_left _ (mem_image_of_mem _ (hb' i).1))
      have h2 : f' (rep (Quotient.mk _ (u i))) = f (rep (Quotient.mk _ (u i))) :=
        apply_eq_of_res_eq hf'r hrepi
      exact Option.some.inj ((hfv i).symm.trans (h1.trans (h2.trans (hb' i).2)))
    rw [← hvb]
    exact hv

end CohCons
